# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vicalba_dev

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── GitHub Webhooks ───────────────────────────────────────────────────────────
# Secret configurado en GitHub → Settings → Webhooks → Secret
# Generar con: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ─── Docker ────────────────────────────────────────────────────────────────────
# Ruta al socket del daemon Docker (por defecto en Linux)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ─── Panel ─────────────────────────────────────────────────────────────────────
# Dominio público del panel (usado para redirects HTTPS en producción)
# PANEL_DOMAIN=panel.tudominio.com

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Monitoring (opcional) ─────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
