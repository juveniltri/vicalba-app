# ================================================================
# vicalba-app — configuración de producción
# Copia este fichero a .env y rellena todos los valores antes
# de ejecutar: docker compose up -d
# ================================================================

# ── Base de datos ────────────────────────────────────────────────
# Contraseña de PostgreSQL — usa una cadena aleatoria segura
DB_PASSWORD=cambia-esto-por-una-contraseña-segura

# URL completa de conexión — sustituye TU_PASSWORD por el valor de DB_PASSWORD
DATABASE_URL=postgresql://vicalba:TU_PASSWORD@db:5432/vicalba

# ── Auth ─────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://panel.tudominio.com

# ── Panel ────────────────────────────────────────────────────────
# Dominio público del panel (sin https://)
PANEL_DOMAIN=panel.tudominio.com

# ── Let's Encrypt ────────────────────────────────────────────────
# Email para notificaciones de caducidad de certificados
ACME_EMAIL=tu@email.com

# ── GitHub Webhooks ──────────────────────────────────────────────
# Genera con: openssl rand -hex 32
# Configura el mismo valor en GitHub → repo → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# ── Cifrado de variables de entorno ──────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Docker ───────────────────────────────────────────────────────
# GID del grupo docker en el host — obtén con: getent group docker | cut -d: -f3
DOCKER_GID=999
