{
  "name": "vicalba-app",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "copy-monaco": "node -e \"require('fs').cpSync('node_modules/monaco-editor/min/vs','public/monaco-editor/vs',{recursive:true,force:true})\"",
    "predev": "npm run copy-monaco",
    "dev": "next dev",
    "prebuild": "npm run copy-monaco",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "guia": "tsx scripts/guia/generar.ts",
    "db:reset": "prisma migrate reset --force",
    "dev:local": "docker compose -f docker-compose.dev.yml up -d --wait && prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next dev",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.76.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "dockerode": "^5.0.1",
    "fflate": "^0.8.3",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "superjson": "^2.2.6",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "overrides": {
    "hono": "^4.12.26",
    "nodemailer": "$nodemailer",
    "prisma": {
      "mysql2": "^3.24.5"
    },
    "deepmerge-ts": "^8.0.2",
    "dompurify": "^3.4.17"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
