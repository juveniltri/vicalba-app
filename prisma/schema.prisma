// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum EstadoServicio {
  running
  stopped
  error
  deploying
}

enum ResultadoDeploy {
  en_curso
  exito
  error
  cancelado
}

enum OrigenDeploy {
  manual
  webhook
  rollback
}

enum TipoProyecto {
  compose
  dockerfile
  image
  nodejs
}

model Cliente {
  id        String     @id @default(cuid())
  slug      String     @unique
  nombre    String
  proyectos Proyecto[]
  creadoEn  DateTime   @default(now())
}

model Credencial {
  id                    String                @id @default(cuid())
  nombre                String                @unique
  clavePublica          String
  clavePrivadaCifrada   String
  iv                    String
  authTag               String
  proyectos             Proyecto[]
  configuracionesBackup ConfiguracionBackup[]
  creadoEn              DateTime              @default(now())
  actualizadoEn         DateTime              @updatedAt
}

model Proyecto {
  id                   String            @id @default(cuid())
  nombre               String
  cliente              Cliente           @relation(fields: [clienteId], references: [id])
  clienteId            String
  estado               EstadoServicio    @default(stopped)
  repositorioUrl       String?
  rama                 String            @default("main")
  autoDeployHabilitado Boolean           @default(false)
  ultimoDeployEn       DateTime?
  ultimoDeployRama     String?
  credencialId         String?
  credencial           Credencial?       @relation(fields: [credencialId], references: [id], onDelete: SetNull)
  tipo                 TipoProyecto      @default(compose)
  puerto               Int?
  imagenUrl            String?
  dockerfilePath       String?
  buildCommand         String?
  startCommand         String?
  composeContent       String?           @db.Text
  backupsHabilitados   Boolean           @default(true)
  elementosBackup      ElementoBackup[]
  variables            VariableEntorno[]
  deploys              Deploy[]
  volumenes            Volumen[]
  rutas                RutaProyecto[]
  creadoEn             DateTime          @default(now())
  actualizadoEn        DateTime          @updatedAt

  @@unique([clienteId, nombre])
}

enum RedireccionWww {
  ninguna
  a_raiz
  a_www
}

model RutaProyecto {
  id             String         @id @default(cuid())
  proyectoId     String
  proyecto       Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  dominio        String
  // "" = whole domain; not nullable so the unique index also covers it
  path           String         @default("")
  servicio       String?
  puerto         Int
  redireccionWww RedireccionWww @default(ninguna)
  // Proxied by Cloudflare: its cert resolver and real-IP strategy
  cloudflare     Boolean        @default(false)
  // Only Cloudflare's edges may connect (ipAllowList on RemoteAddr)
  soloCloudflare Boolean        @default(false)
  // Validated with middlewaresSchema (src/lib/schemas/middlewares.ts)
  middlewares    Json           @default("{}")
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  @@unique([dominio, path])
  @@index([proyectoId])
}

model VariableEntorno {
  id            String   @id @default(cuid())
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId    String
  clave         String
  valorCifrado  String
  iv            String
  authTag       String
  enBuildTime   Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([proyectoId, clave])
}

model Volumen {
  id             String   @id @default(cuid())
  proyectoId     String
  proyecto       Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre         String
  rutaContenedor String
  creadoEn       DateTime @default(now())

  @@unique([proyectoId, nombre])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nombre        String
  creadoEn      DateTime @default(now())
  // Sessions issued before this instant are rejected (password change).
  sesionesDesde DateTime @default(now())
}

model Deploy {
  id           String          @id @default(cuid())
  proyecto     Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId   String
  rama         String
  sha          String?
  resultado    ResultadoDeploy @default(en_curso)
  origen       OrigenDeploy    @default(manual)
  output       String?
  iniciadoEn   DateTime        @default(now())
  finalizadoEn DateTime?

  @@index([proyectoId, iniciadoEn(sort: Desc)])
}

model ConfiguracionDeploy {
  id             String @id @default("default")
  // 0 disables the automatic cancellation.
  timeoutMinutos Int    @default(30)
}

model ConfiguracionNotificacion {
  id String @id @default("default")

  webhookHabilitado Boolean @default(false)
  webhookUrl        String?

  emailHabilitado   Boolean @default(false)
  emailSmtpHost     String?
  emailSmtpPort     Int?
  emailSmtpUser     String?
  emailSmtpPass     String?
  emailSmtpPassIv   String?
  emailSmtpPassTag  String?
  emailRemitente    String?
  emailDestinatario String?

  telegramHabilitado      Boolean @default(false)
  telegramBotTokenCifrado String?
  telegramBotTokenIv      String?
  telegramBotTokenTag     String?
  telegramChatId          String?

  // Last delivery attempt per channel; error null means it succeeded.
  webhookUltimoEnvioEn  DateTime?
  webhookUltimoError    String?
  emailUltimoEnvioEn    DateTime?
  emailUltimoError      String?
  telegramUltimoEnvioEn DateTime?
  telegramUltimoError   String?
}

enum DestinoBackup {
  s3
  sftp
  local
}

enum OperacionBackup {
  copia
  restauracion
}

enum OrigenBackup {
  programado
  manual
  antes_de_restaurar
}

enum ResultadoBackup {
  en_curso
  exito
  error
}

model ConfiguracionBackup {
  id          String         @id @default("default")
  habilitado  Boolean        @default(false)
  // 0-23, Europe/Madrid
  hora        Int            @default(3)
  tipoDestino DestinoBackup?

  s3Endpoint         String?
  s3Bucket           String?
  s3Region           String?
  s3Prefijo          String?
  s3AccessKeyId      String?
  s3SecretKeyCifrada String?
  s3SecretKeyIv      String?
  s3SecretKeyTag     String?

  sftpHost         String?
  sftpPuerto       Int         @default(22)
  sftpUsuario      String?
  sftpRuta         String?
  sftpCredencialId String?
  sftpCredencial   Credencial? @relation(fields: [sftpCredencialId], references: [id], onDelete: SetNull)

  claveCifrada              String?
  claveIv                   String?
  claveTag                  String?
  claveConfirmadaEn         DateTime?
  repositorioInicializadoEn DateTime?
}

model Backup {
  id             String          @id @default(cuid())
  operacion      OperacionBackup @default(copia)
  origen         OrigenBackup
  resultado      ResultadoBackup @default(en_curso)
  iniciadoEn     DateTime        @default(now())
  finalizadoEn   DateTime?
  snapshotId     String?
  bytesAnadidos  BigInt?
  error          String?         @db.Text
  // null = the Panel's own copy. No relation: history outlives a deleted Proyecto
  proyectoId     String?
  // "<cliente>/<proyecto>" at the time of the copy
  proyectoNombre String?
  elementos      ElementoCopia[]

  @@index([iniciadoEn])
  @@index([proyectoId, iniciadoEn])
}

// Only written when the user toggles a checkbox: a detected item without a row is included
model ElementoBackup {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  // bd:<db>, datos:./data/media, volumen:<x>
  clave      String
  incluido   Boolean  @default(true)
  creadoEn   DateTime @default(now())

  @@unique([proyectoId, clave])
}

model ElementoCopia {
  id            String          @id @default(cuid())
  backupId      String
  backup        Backup          @relation(fields: [backupId], references: [id], onDelete: Cascade)
  clave         String
  resultado     ResultadoBackup @default(en_curso)
  snapshotIds   String[]
  bytesAnadidos BigInt?
  error         String?         @db.Text

  @@index([backupId])
}

enum EstadoProxy {
  aplicada
  en_curso
  revertida
  error
}

// Configuración → Proxy. "aplicada" is what Traefik is running; "pendiente" the
// last request, kept when it was reverted or failed so the UI can show it.
model ConfiguracionProxy {
  id             String      @id @default("default")
  aplicada       Json
  pendiente      Json?
  estado         EstadoProxy @default(aplicada)
  mensaje        String?
  log            String?     @db.Text
  // Cloudflare API token (DNS-01), AES-256-GCM like the other secrets
  cfTokenCifrado String?
  cfTokenIv      String?
  cfTokenAuthTag String?
  actualizadoEn  DateTime    @updatedAt
}
