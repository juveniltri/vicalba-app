// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum EstadoServicio {
  running
  stopped
  error
  deploying
}

enum ResultadoDeploy {
  en_curso
  exito
  error
  cancelado
}

enum OrigenDeploy {
  manual
  webhook
  rollback
}

enum TipoProyecto {
  compose
  dockerfile
  image
  nodejs
}

model Cliente {
  id        String     @id @default(cuid())
  slug      String     @unique
  nombre    String
  proyectos Proyecto[]
  creadoEn  DateTime   @default(now())
}

model Credencial {
  id                    String                @id @default(cuid())
  nombre                String                @unique
  clavePublica          String
  clavePrivadaCifrada   String
  iv                    String
  authTag               String
  proyectos             Proyecto[]
  configuracionesBackup ConfiguracionBackup[]
  creadoEn              DateTime              @default(now())
  actualizadoEn         DateTime              @updatedAt
}

model Proyecto {
  id                   String            @id @default(cuid())
  nombre               String
  cliente              Cliente           @relation(fields: [clienteId], references: [id])
  clienteId            String
  estado               EstadoServicio    @default(stopped)
  dominio              String?
  repositorioUrl       String?
  rama                 String            @default("main")
  autoDeployHabilitado Boolean           @default(false)
  ultimoDeployEn       DateTime?
  ultimoDeployRama     String?
  credencialId         String?
  credencial           Credencial?       @relation(fields: [credencialId], references: [id], onDelete: SetNull)
  tipo                 TipoProyecto      @default(compose)
  puerto               Int?
  imagenUrl            String?
  dockerfilePath       String?
  buildCommand         String?
  startCommand         String?
  composeContent       String?           @db.Text
  variables            VariableEntorno[]
  deploys              Deploy[]
  volumenes            Volumen[]
  creadoEn             DateTime          @default(now())
  actualizadoEn        DateTime          @updatedAt

  @@unique([clienteId, nombre])
}

model VariableEntorno {
  id            String   @id @default(cuid())
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId    String
  clave         String
  valorCifrado  String
  iv            String
  authTag       String
  enBuildTime   Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([proyectoId, clave])
}

model Volumen {
  id             String   @id @default(cuid())
  proyectoId     String
  proyecto       Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre         String
  rutaContenedor String
  creadoEn       DateTime @default(now())

  @@unique([proyectoId, nombre])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nombre        String
  creadoEn      DateTime @default(now())
  // Sessions issued before this instant are rejected (password change).
  sesionesDesde DateTime @default(now())
}

model Deploy {
  id           String          @id @default(cuid())
  proyecto     Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId   String
  rama         String
  sha          String?
  resultado    ResultadoDeploy @default(en_curso)
  origen       OrigenDeploy    @default(manual)
  output       String?
  iniciadoEn   DateTime        @default(now())
  finalizadoEn DateTime?

  @@index([proyectoId, iniciadoEn(sort: Desc)])
}

model ConfiguracionDeploy {
  id             String @id @default("default")
  // 0 disables the automatic cancellation.
  timeoutMinutos Int    @default(30)
}

model ConfiguracionNotificacion {
  id String @id @default("default")

  webhookHabilitado Boolean @default(false)
  webhookUrl        String?

  emailHabilitado   Boolean @default(false)
  emailSmtpHost     String?
  emailSmtpPort     Int?
  emailSmtpUser     String?
  emailSmtpPass     String?
  emailSmtpPassIv   String?
  emailSmtpPassTag  String?
  emailRemitente    String?
  emailDestinatario String?

  telegramHabilitado      Boolean @default(false)
  telegramBotTokenCifrado String?
  telegramBotTokenIv      String?
  telegramBotTokenTag     String?
  telegramChatId          String?

  // Last delivery attempt per channel; error null means it succeeded.
  webhookUltimoEnvioEn  DateTime?
  webhookUltimoError    String?
  emailUltimoEnvioEn    DateTime?
  emailUltimoError      String?
  telegramUltimoEnvioEn DateTime?
  telegramUltimoError   String?
}

enum DestinoBackup {
  s3
  sftp
}

enum OperacionBackup {
  copia
  restauracion
}

enum OrigenBackup {
  programado
  manual
  antes_de_restaurar
}

enum ResultadoBackup {
  en_curso
  exito
  error
}

model ConfiguracionBackup {
  id          String         @id @default("default")
  habilitado  Boolean        @default(false)
  // 0-23, Europe/Madrid
  hora        Int            @default(3)
  tipoDestino DestinoBackup?

  s3Endpoint         String?
  s3Bucket           String?
  s3Region           String?
  s3Prefijo          String?
  s3AccessKeyId      String?
  s3SecretKeyCifrada String?
  s3SecretKeyIv      String?
  s3SecretKeyTag     String?

  sftpHost         String?
  sftpPuerto       Int         @default(22)
  sftpUsuario      String?
  sftpRuta         String?
  sftpCredencialId String?
  sftpCredencial   Credencial? @relation(fields: [sftpCredencialId], references: [id], onDelete: SetNull)

  claveCifrada              String?
  claveIv                   String?
  claveTag                  String?
  claveConfirmadaEn         DateTime?
  repositorioInicializadoEn DateTime?
}

model Backup {
  id            String          @id @default(cuid())
  operacion     OperacionBackup @default(copia)
  origen        OrigenBackup
  resultado     ResultadoBackup @default(en_curso)
  iniciadoEn    DateTime        @default(now())
  finalizadoEn  DateTime?
  snapshotId    String?
  bytesAnadidos BigInt?
  error         String?         @db.Text

  @@index([iniciadoEn])
}
